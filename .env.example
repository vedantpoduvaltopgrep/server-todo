# Copy to .env and fill in. Load it with `node --env-file=.env server.js`
# (or export these manually before `npm start`).

# quant0 api-gateway's public host — local default from quant0-enterprise
# `make deps-up && make migrate && make up`.
QUANT0_GATEWAY_URL=http://localhost:8082

# From registering this app (see ../README.md) as a `regular_web` application
# with "require_pkce": false. client_secret is shown ONCE, at creation time —
# copy it immediately, it is never shown again (rotate via
# POST /v1/org/applications/{id}/rotate-secret if you lose it).
QUANT0_CLIENT_ID=app_xxxxxxxxxxxxxxxx
QUANT0_CLIENT_SECRET=qa_xxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3200

# Must exactly match one of this application's registered redirect_uris.
QUANT0_REDIRECT_URI=http://localhost:3200/callback

# Optional — only needed if another q0-agent already owns the SDK's default
# port (127.0.0.1:9595), e.g. a second agent enrolled for a different app/org
# on this same machine.
# QUANT0_AGENT_URL=http://127.0.0.1:9596

# quant0-client/apps/account-portal's local dev origin (deploy/k8s/values/
# envs/local/iam-core.yaml's ACCOUNT_PORTAL_URL). The "Manage account" link
# is a plain deep link (?client_id=...) — simplest of the two documented
# options, no server-side ticket-minting needed for a local demo.
QUANT0_ACCOUNT_PORTAL_URL=http://localhost:3001
